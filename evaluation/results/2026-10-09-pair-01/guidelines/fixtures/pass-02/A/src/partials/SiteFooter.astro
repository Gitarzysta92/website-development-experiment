---
import { company,projects } from '../content/index';
import { routeFor,labelFor,type Locale,type PageId } from '../navigation/index';
interface Props {locale:Locale;}
const {locale}=Astro.props;const pl=locale==='pl';
---
<footer class="site-footer"><div class="container"><div class="footer-grid"><div><a class="footer-wordmark" href={routeFor('home',locale)}>artifactory<span aria-hidden="true">·</span></a><p>{company.summary[locale]}</p><a class="email" href={`mailto:${company.email}`}>{company.email} <span aria-hidden="true">↗</span></a></div><nav aria-label={pl?'Firma — stopka':'Company — footer'}><h2>{pl?'Firma':'Company'}</h2>{(['home','projects','investors','approach','about'] as PageId[]).map(id=><a href={routeFor(id,locale)}>{labelFor(id,locale)}</a>)}</nav><nav aria-label={pl?'Projekty — stopka':'Projects — footer'}><h2>{pl?'Projekty':'Projects'}</h2>{projects.map(p=><a href={routeFor(p.id,locale)}>{p.name}</a>)}</nav><nav aria-label={pl?'Kontakt — stopka':'Connect — footer'}><h2>{pl?'Porozmawiajmy':'Connect'}</h2>{(['partnerships','contact','privacy'] as PageId[]).map(id=><a href={routeFor(id,locale)}>{labelFor(id,locale)}</a>)}</nav></div><div class="footer-bottom"><span>Artifactory</span><span>{pl?'Światło otwiera nowe możliwości.':'New possibilities, through light.'}</span></div></div></footer>
<style>.site-footer{background:var(--af-ink);color:white;padding:64px 0 24px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1.2fr;gap:48px}.footer-wordmark{font-size:32px;letter-spacing:-1px;font-weight:550;text-decoration:none!important;display:inline-block;margin-bottom:20px}.footer-wordmark span{color:var(--af-white)}.footer-grid p{font-size:16px;max-width:30ch;color:var(--af-line)}.site-footer a{color:white}.site-footer a:hover{color:var(--af-line)}.site-footer a:focus-visible{outline-color:white}.email{display:inline-flex;gap:16px;font-size:16px;margin-top:28px;min-height:44px;align-items:center}.site-footer h2{font-size:16px;letter-spacing:0;font-weight:650;margin:6px 0 20px}.site-footer nav a{display:block;font-size:16px;padding:6px 0;text-decoration:none;min-height:36px}.site-footer nav a:hover{text-decoration:underline}.footer-bottom{border-top:1px solid #5c6470;margin-top:56px;padding-top:24px;display:flex;justify-content:space-between;gap:20px;font-size:16px;color:var(--af-line)}@media(max-width:72rem){.footer-grid{grid-template-columns:2fr 1fr;gap:40px}}@media(max-width:48rem){.footer-grid{grid-template-columns:1fr 1fr;gap:32px 20px}.footer-grid>div{grid-column:1/-1}.footer-bottom{flex-direction:column;margin-top:40px}.site-footer{padding-top:48px}}</style>
