---
import { routeFor, contactHref, labelFor, type PageId, type Locale } from '../navigation/index';
import Button from '../components/ui/Button.astro';
interface Props {id:PageId;locale:Locale;translationAvailable?:boolean;sectionIds?:string[];}
const {id,locale,translationAvailable=true,sectionIds=[]}=Astro.props;
const pl=locale==='pl';const other=pl?'en':'pl';
---
<header class="site-header" data-header><div class="container header-inner"><a class="wordmark" href={routeFor('home',locale)} aria-label={pl?'Artifactory — strona główna':'Artifactory — home'}><span class="mark" aria-hidden="true">a<span>·</span></span>artifactory</a><button class="menu-toggle" aria-expanded="false" aria-controls="global-navigation" data-menu>{pl?'Menu':'Menu'} <span aria-hidden="true">☰</span></button><nav id="global-navigation" aria-label={pl?'Nawigacja główna':'Main navigation'}><div class="nav-links"><details class="projects-menu"><summary class:list={[id==='projects'||id.startsWith('arti')||id.startsWith('aifield')?'selected':'']}>{labelFor('projects',locale)} <span aria-hidden="true">⌄</span></summary><div class="project-options">{(['projects','artisense','aifield'] as PageId[]).map(target=><a href={routeFor(target,locale)} aria-current={id===target?'page':undefined}>{target==='projects'?(pl?'Wszystkie projekty':'All projects'):labelFor(target,locale)}<span aria-hidden="true">↗</span></a>)}</div></details>{(['investors','approach','about'] as PageId[]).map(target=><a href={routeFor(target,locale)} aria-current={id===target?'page':undefined}>{labelFor(target,locale)}</a>)}<a class="mobile-utility" href={routeFor('partnerships',locale)}>{labelFor('partnerships',locale)}</a><a class="mobile-utility" href={routeFor('contact',locale)}>{labelFor('contact',locale)}</a></div><div class="nav-actions">{translationAvailable?<a class="language" data-language data-sections={sectionIds.join(',')} href={routeFor(id,other)} lang={other} hreflang={other} aria-label={pl?'Read this page in English':'Czytaj tę stronę po polsku'}>{pl?'EN':'PL'} <span aria-hidden="true">↔</span></a>:<span class="language" aria-disabled="true" title={pl?'Tłumaczenie jest niedostępne.':'Translation is unavailable.'}>{pl?'EN':'PL'}</span>}<Button href={contactHref(locale,'investment')}>{pl?'Porozmawiajmy':'Let’s talk'}</Button></div></nav></div></header>
<script>import './site-header';</script>
<style>
.site-header{position:sticky;top:0;z-index:var(--z-header);background:var(--af-white);border-bottom:1px solid var(--af-line)}.header-inner{min-height:88px;display:flex;align-items:center;gap:36px}.wordmark{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--af-ink);font-size:25px;font-weight:650;letter-spacing:-1px;flex-shrink:0}.mark{font-size:33px;color:var(--af-purple);font-weight:500;line-height:1}.mark span{color:var(--af-teal);font-size:45px}nav{display:flex;align-items:center;justify-content:space-between;gap:24px;flex:1}.nav-links,.nav-actions{display:flex;align-items:center;gap:24px}.nav-links>a,.projects-menu summary{font-size:16px;text-decoration:none;min-height:44px;display:flex;align-items:center;color:var(--af-ink);gap:8px}.nav-links>a:hover,.projects-menu summary:hover{color:var(--af-purple)}[aria-current=page],.selected{color:var(--af-purple)!important;font-weight:600}.projects-menu{position:relative}.projects-menu summary{list-style:none}.projects-menu summary::-webkit-details-marker{display:none}.project-options{position:absolute;z-index:var(--z-menu);min-width:230px;top:calc(100% + 10px);left:-16px;background:white;border:1px solid var(--af-line);border-radius:var(--radius);padding:12px;box-shadow:var(--shadow)}.project-options a{display:flex;justify-content:space-between;gap:16px;padding:12px;border-radius:8px;text-decoration:none;font-size:16px;color:var(--af-ink)}.project-options a:hover{background:var(--af-mist)}.language{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-size:16px;color:var(--af-ink);text-decoration:none}.menu-toggle,.mobile-utility{display:none!important}
@media(max-width:72rem){.header-inner{flex-wrap:wrap;justify-content:space-between;gap:0;min-height:76px}.menu-toggle{display:flex!important;align-items:center;gap:12px;background:white;border:1px solid var(--af-muted);border-radius:var(--radius);padding:9px 16px;min-height:44px;font-size:16px}nav{width:100%;flex-basis:100%;display:block;padding:16px 0 24px}.site-header[data-enhanced] nav{display:none}.site-header[data-open] nav{display:block}.nav-links{display:block}.nav-links>a,.projects-menu summary{padding:10px 0;min-height:48px}.mobile-utility{display:flex!important}.nav-actions{margin-top:20px;gap:28px}.project-options{position:static;box-shadow:none;margin:4px 0 12px;border:0;border-left:2px solid var(--af-line);border-radius:0;padding:0 0 0 12px}.wordmark{font-size:24px}}
@media(max-width:72rem) and (scripting:enabled){.site-header nav{display:none}.site-header[data-open] nav{display:block}}
@media(max-height:600px){.site-header{position:relative}}
</style>
