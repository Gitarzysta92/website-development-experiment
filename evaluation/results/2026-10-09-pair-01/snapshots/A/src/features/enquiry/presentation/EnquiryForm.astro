---
import { formCopy } from './copy';
import { routeFor, type Locale } from '../../../navigation/index';
interface Props {locale:Locale;}
const {locale}=Astro.props;const t=formCopy[locale];
---
<div class="form-panel"><div class="test-notice"><strong>{t.test}</strong><p>{t.notice}</p></div><noscript><p class="evidence-note">{t.nojs}</p></noscript><form method="post" action="/api/enquiries" data-enquiry data-locale={locale} novalidate><div class="form-status" role="status" aria-live="polite" tabindex="-1" hidden></div><div class="field"><label for="intent">{t.intent}</label><select id="intent" name="intent" required aria-describedby="intent-error">{(['general','investment','partnership','demo'] as const).map(value=><option value={value}>{t[value]}</option>)}</select><span class="field-error" id="intent-error"></span></div><div class="field"><label for="project">{t.project}</label><select id="project" name="project"><option value="">{t.unspecified}</option><option value="artisense">ArtiSense</option><option value="aifield">AIFIELD</option></select></div><div class="form-row">{(['name','organization'] as const).map(name=><div class="field"><label for={name}>{t[name]}</label><input id={name} name={name} type="text" autocomplete="off" aria-describedby={`${name}-error`}/><span class="field-error" id={`${name}-error`}></span></div>)}</div><div class="field"><label for="email">{t.email} <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" required autocomplete="off" aria-describedby="email-error"/><span class="field-error" id="email-error"></span></div><div class="field"><label for="message">{t.message} <span aria-hidden="true">*</span></label><p id="message-hint" class="field-hint">{t.messageHint}</p><textarea id="message" name="message" rows="6" required aria-describedby="message-hint message-error"></textarea><span class="field-error" id="message-error"></span></div><div hidden aria-hidden="true"><label for="website">Website<input id="website" name="website" type="text" tabindex="-1" autocomplete="off"/></label></div><p class="privacy-link"><a href={routeFor('privacy',locale)}>{t.privacy}</a></p><div class="actions"><button class="button" type="submit" data-submit disabled>{t.send} <span aria-hidden="true">↗</span></button><button type="button" class="button secondary" data-new hidden>{t.new}</button></div></form></div>
<script>import './controller';</script>
<style>.form-panel{padding:40px;border:1px solid var(--af-line);border-radius:20px;box-shadow:var(--shadow);background:white}.test-notice{border-left:3px solid var(--af-teal);padding:16px 20px;background:var(--af-mist);margin-bottom:32px;font-size:16px}.test-notice p{margin-top:8px}.field{margin-top:24px;min-width:0}.field label{display:block;margin-bottom:8px;font-size:16px;font-weight:600}.field input,.field select,.field textarea{display:block;width:100%;min-height:48px;border:1px solid var(--af-muted);border-radius:8px;padding:12px;background:white;color:var(--af-ink);font-size:16px}.field textarea{resize:vertical;min-height:160px}.field input[aria-invalid=true],.field textarea[aria-invalid=true],.field select[aria-invalid=true]{border:2px solid var(--af-purple)}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}.field-hint{font-size:16px;color:var(--af-muted);margin-bottom:10px}.field-error{display:block;font-size:16px;color:var(--af-purple);margin-top:6px;min-height:0}.field-error:empty{display:none}.privacy-link{font-size:16px;margin-top:24px}.form-status{font-size:16px;border:2px solid var(--af-purple);border-radius:12px;padding:20px;background:var(--af-mist);margin-bottom:24px}.form-status[data-state=accepted]{border-color:var(--af-teal)}@media(max-width:48rem){.form-panel{padding:24px 20px}.form-row{grid-template-columns:1fr;gap:0}}
</style>
