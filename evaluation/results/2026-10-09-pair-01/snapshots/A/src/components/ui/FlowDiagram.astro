---
interface Props{steps:{title:string;description:string}[];caption:string;}
const {steps,caption}=Astro.props;
---
<figure class="flow-diagram"><ol>{steps.map((step,i)=><li><span class="step-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><strong>{step.title}</strong><p>{step.description}</p></div>{i<steps.length-1&&<span class="step-arrow" aria-hidden="true">↓</span>}</li>)}</ol><figcaption>{caption}</figcaption></figure>
<style>.flow-diagram{margin-bottom:48px;background:var(--af-mist);border:1px solid var(--af-line);border-radius:20px;padding:32px}.flow-diagram ol{list-style:none;padding:0;margin:0}.flow-diagram li{display:grid;grid-template-columns:40px 1fr;gap:20px;margin:0}.step-number{font:16px/1.5 var(--mono);color:var(--af-purple);padding-top:2px}.flow-diagram strong{font-size:20px;font-weight:550}.flow-diagram p{font-size:16px;color:var(--af-muted);margin-top:6px}.step-arrow{grid-column:2;font-size:24px;color:var(--af-teal);height:32px}.flow-diagram figcaption{margin-top:28px;padding-top:20px;border-top:1px solid var(--af-line);font-size:16px;color:var(--af-muted)}@media(max-width:48rem){.flow-diagram{padding:24px 20px}.flow-diagram li{grid-template-columns:26px 1fr;gap:12px}}</style>
