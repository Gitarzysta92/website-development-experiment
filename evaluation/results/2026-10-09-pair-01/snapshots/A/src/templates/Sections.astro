---
import type { PageView } from '../content/index';
import {routeFor,labelFor,type PageId} from '../navigation/index';
import EvidenceTable from '../components/ui/EvidenceTable.astro';
interface Props{page:PageView;}
const {page}=Astro.props;
---
{page.sections.map(s=><section class="body-section" id={s.id}><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.items&&<ul>{s.items.map(item=><li>{item}</li>)}</ul>}{s.rows&&<EvidenceTable label={s.title} rows={s.rows} headers={page.locale==='pl'?['Obszar','Zakres i ograniczenia']:['Area','Scope and limitations']}/>}<div class="actions">{s.links?.map(link=><a class="text-link" href={routeFor(link.id as PageId,page.locale)}>{link.label||labelFor(link.id as PageId,page.locale)} <span aria-hidden="true">↗</span></a>)}</div></section>)}
