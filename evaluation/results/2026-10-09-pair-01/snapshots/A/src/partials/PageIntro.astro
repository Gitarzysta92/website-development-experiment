---
import type {PageView} from '../content/index';
interface Props{page:PageView;}const {page}=Astro.props;
---
<section class="page-hero"><div class="container"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lead">{page.lead}</p>{page.maturity&&<div class="actions"><span class="badge">{page.maturity}</span></div>}</div></section>
