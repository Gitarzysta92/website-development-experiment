---
import { projectPages,type PageId,type Locale,type ProjectId } from '../navigation/index';
interface Props {id:PageId;locale:Locale;project:ProjectId;}
const {id,locale,project}=Astro.props;const pl=locale==='pl';
---
<nav class="project-nav" aria-label={pl?'Strony projektu':'Project pages'} data-project-navigation><button class="project-toggle" aria-expanded="false" aria-controls="project-links" data-project-toggle>{project==='artisense'?'ArtiSense':'AIFIELD'} — {pl?'na tej stronie':'explore'} <span aria-hidden="true">⌄</span></button><div id="project-links"><p class="project-name">{project==='artisense'?'ArtiSense':'AIFIELD'}</p>{projectPages(project,locale).map(p=><a href={p.href} aria-current={id===p.id?'page':undefined}>{p.label}</a>)}</div></nav>
<script>
const nav=document.querySelector<HTMLElement>('[data-project-navigation]');
if(nav){const button=nav.querySelector<HTMLButtonElement>('[data-project-toggle]')!;const media=matchMedia('(max-width:48rem)');nav.dataset.enhanced='';const close=()=>{delete nav.dataset.open;button.setAttribute('aria-expanded','false');};button.addEventListener('click',()=>{if(nav.hasAttribute('data-open'))close();else{nav.dataset.open='';button.setAttribute('aria-expanded','true');}});nav.addEventListener('keydown',e=>{if(e.key==='Escape'&&nav.hasAttribute('data-open')){close();button.focus();}});media.addEventListener('change',()=>{const inside=nav.contains(document.activeElement);close();if(inside&&media.matches)button.focus();});}
</script>
<style>.project-name{font-size:20px;font-weight:600;margin-bottom:16px}.project-nav a{display:block;padding:10px 14px;margin-left:-14px;font-size:16px;line-height:1.5;text-decoration:none;color:var(--af-muted);border-radius:8px}.project-nav a:hover{color:var(--af-purple);background:var(--af-mist)}.project-nav a[aria-current]{background:var(--af-mist);color:var(--af-purple);font-weight:600;border-left:2px solid var(--af-purple)}.project-toggle{display:none}@media(max-width:48rem){.project-toggle{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:16px;min-height:48px;width:100%;background:var(--af-mist);border:1px solid var(--af-muted);padding:12px 16px;border-radius:12px}.project-nav[data-enhanced] #project-links{display:none}.project-nav[data-open] #project-links{display:block}.project-name{margin-top:24px}.project-nav a{margin-left:0}}@media(max-width:48rem) and (scripting:enabled){.project-nav #project-links{display:none}.project-nav[data-open] #project-links{display:block}}</style>
