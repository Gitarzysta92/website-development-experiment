---
import '../styles/global.css';
import type { PageView } from '../content/index';
import { metadata } from '../metadata/index';
import { publicConfig } from '../config/public';
interface Props {page:PageView;recovery?:boolean;}
const {page,recovery=false}=Astro.props;const meta=metadata(page,publicConfig.origin,publicConfig.profile);
---
<!doctype html><html lang={page.locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{meta.title}</title><meta name="description" content={meta.description}/><meta name="robots" content={recovery?'noindex, nofollow':meta.robots}/>{!recovery&&<link rel="canonical" href={meta.canonical}/>}{!recovery&&meta.alternates.map(a=><link rel="alternate" hreflang={a.lang} href={a.href}/>)}<meta property="og:type" content="website"/><meta property="og:site_name" content="Artifactory"/><meta property="og:title" content={meta.title}/><meta property="og:description" content={meta.description}/>{!recovery&&<meta property="og:url" content={meta.canonical}/>}<meta property="og:locale" content={page.locale==='pl'?'pl_PL':'en_GB'}/><meta property="og:image" content={meta.image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><link rel="icon" href="/brand/favicon-v1.svg" type="image/svg+xml"/></head><body><a class="skip-link" href="#main">{page.locale==='en'?'Skip to content':'Przejdź do treści'}</a>{publicConfig.profile==='preview'&&<div class="draft-note" role="region" aria-label={page.locale==='pl'?'Status publikacji':'Publication status'}>{page.locale==='en'?'Local draft · Research in progress':'Wersja lokalna · Badania w toku'}</div>}<slot name="header"/><main id="main" tabindex="-1"><slot name="lead"/><slot name="body"/><slot/><slot name="aside"/></main><slot name="footer"/></body></html>
