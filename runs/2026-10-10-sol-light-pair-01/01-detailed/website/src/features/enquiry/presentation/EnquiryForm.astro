---
import type { Locale } from '../../../navigation';
const {locale}=Astro.props as {locale:Locale};
const t=locale==='en'?{notice:'Test mode: a successful submission creates a local receipt only. No email is sent.',intent:'Topic',investment:'Investment',partnership:'Partnership',demo:'Demo',general:'General',project:'Project',none:'Not specified',name:'Name (optional)',organization:'Organization (optional)',email:'Email',message:'Message',submit:'Send test enquiry',alternative:'Or use your own email client:',js:'JavaScript is required for the local test form. You can still use email.'}:{notice:'Tryb testowy: udane zgłoszenie tworzy tylko lokalne potwierdzenie. Nie wysyła e-maila.',intent:'Temat',investment:'Inwestycja',partnership:'Współpraca',demo:'Demo',general:'Ogólne',project:'Projekt',none:'Nie określono',name:'Imię i nazwisko (opcjonalnie)',organization:'Organizacja (opcjonalnie)',email:'E-mail',message:'Wiadomość',submit:'Wyślij zapytanie testowe',alternative:'Możesz też użyć własnego klienta poczty:',js:'Formularz testowy wymaga JavaScriptu. Możesz nadal użyć e-maila.'};
---
<div class="form-wrap"><p class="notice">{t.notice}</p><form id="enquiry" data-locale={locale} novalidate><div class="field"><label for="intent">{t.intent}</label><select id="intent" name="intent" required><option value="investment">{t.investment}</option><option value="partnership">{t.partnership}</option><option value="demo">{t.demo}</option><option value="general">{t.general}</option></select></div><div class="field"><label for="project">{t.project}</label><select id="project" name="project"><option value="">{t.none}</option><option value="artisense">ArtiSense</option><option value="aifield">AIFIELD</option></select></div><div class="field"><label for="name">{t.name}</label><input id="name" name="name" maxlength="100" autocomplete="name"/></div><div class="field"><label for="organization">{t.organization}</label><input id="organization" name="organization" maxlength="150" autocomplete="organization"/></div><div class="field"><label for="email">{t.email}</label><input id="email" name="email" type="email" maxlength="254" required autocomplete="email"/></div><div class="field"><label for="message">{t.message}</label><textarea id="message" name="message" minlength="20" maxlength="5000" required></textarea></div><div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div><button class="button" type="submit">{t.submit}</button><p class="form-status" role="status" aria-live="polite"></p></form><p>{t.alternative} <a href="mailto:info@artifactory.tech">info@artifactory.tech</a></p><noscript><p>{t.js}</p></noscript></div>
<script>import {mountEnquiry} from './controller';mountEnquiry();</script>
