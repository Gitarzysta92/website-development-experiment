---
import PageFrame from '../layouts/PageFrame.astro';
import { routes, routeFor, ancestors, projectPages, contactHref, type Locale, type PageId } from '../navigation';
import { getPageView } from '../content';
import '../content/pages';
import EnquiryForm from '../features/enquiry/presentation/EnquiryForm.astro';
export function getStaticPaths(){return routes.flatMap(route=> (['en','pl'] as Locale[]).map(locale=>({params:{path:route.paths[locale].slice(1,-1)},props:{id:route.id as PageId,locale}})))}
const {id,locale}=Astro.props as {id:PageId;locale:Locale};
const page=getPageView(id,locale)!;
const route=routes.find(r=>r.id===id)!;
const project=route.project;
const siblings=project?projectPages(project):[];
const contact=contactHref(locale,id==='partnerships'?'partnership':project==='aifield'?'demo':'investment',project as 'artisense' | 'aifield' | undefined);
const diagramLabels:Record<string,[string[],string[]]>={
'artisense-technology':[['Illuminate','Optical response','Detect','Interpret'],['Oświetlenie','Odpowiedź optyczna','Detekcja','Interpretacja']],
'aifield-design':[['Geometry','Process model','Simulate','Inspect'],['Geometria','Model procesu','Symulacja','Analiza']],
'aifield-ai':[['Engineer sets task','Agent proposes','Human reviews','Solver runs'],['Inżynier definiuje','AI proponuje','Człowiek ocenia','Solwer działa']],
'aifield-neural':[['Boundary data','Model prediction','Reference solver','Compare error'],['Dane brzegowe','Predykcja modelu','Solwer odniesienia','Porównanie błędu']]};
const steps=diagramLabels[id]?.[locale==='en'?0:1];
const cta=locale==='en'?(project==='aifield'?'Request a demo':id==='partnerships'?'Discuss a partnership':'Discuss an investment'):(project==='aifield'?'Poproś o demo':id==='partnerships'?'Porozmawiajmy o współpracy':'Porozmawiajmy o inwestycji');
---
<PageFrame {id} {locale} title={page.title} description={page.description}>
{ id!=='home' && <div class="container breadcrumbs" aria-label={locale==='en'?'Breadcrumb':'Ścieżka'}><a href={routeFor('home',locale)}>{locale==='en'?'Home':'Strona główna'}</a>{ancestors(id).filter(a=>a.id!=='home').map(a=><><span aria-hidden="true">/</span><a href={routeFor(a.id,locale)}>{a.labels[locale]}</a></>)}<span aria-hidden="true">/</span><span aria-current="page">{route.labels[locale]}</span></div>}
{project && <div class="container project-nav" aria-label={locale==='en'?'Project pages':'Strony projektu'}>{siblings.map(s=><a href={routeFor(s.id,locale)} aria-current={s.id===id?'page':undefined}>{s.id===project?(locale==='en'?'Overview':'Przegląd'):s.labels[locale]}</a>)}</div>}
<section class="hero"><div class="container hero-grid"><div><p class="eyebrow">{page.eyebrow} / {locale==='en'?'Explore':'Odkryj'}</p><h1>{page.title}</h1><p class="lead">{page.lead}</p><p class="intro">{page.description}</p><div class="hero-actions">{id!=='contact'&&id!=='privacy'&&<><a class="button" href={id==='home'?routeFor('investors',locale):contact}>{id==='home'?(locale==='en'?'Explore the investment case':'Poznaj potencjał inwestycyjny'):cta}</a><a class="button secondary" href={routeFor('projects',locale)}>{locale==='en'?'Explore projects':'Poznaj projekty'}</a></>}</div></div><div class="concept" role="img" aria-label={steps?(locale==='en'?'Concept process diagram: ':'Koncepcyjny schemat procesu: ')+steps.join(' → '):(locale==='en'?'Concept illustration: a central light signal with surrounding propagation rings; not a measured result.':'Ilustracja koncepcyjna: sygnał świetlny i otaczające go pierścienie propagacji; nie jest wynikiem pomiaru.')}><span class="figure-label">ARTIFACTORY / {project?.toUpperCase()??'PHOTONICS'}</span>{steps?<div class="concept-flow" aria-hidden="true">{steps.map((step,i)=><div class="flow-step"><b>0{i+1}</b><span>{step}</span></div>)}</div>:<span class="point"></span>}<span class="caption">{locale==='en'?'Concept diagram · light, systems and interpretation':'Diagram koncepcyjny · światło, systemy i interpretacja'}</span></div></div></section>
{(id==='home'||id==='projects')&&<section class="section project-feature"><div class="container"><p class="eyebrow">{locale==='en'?'The work / 02 directions':'Nasze prace / 02 kierunki'}</p><h2>{locale==='en'?'One company. Two technical questions.':'Jedna spółka. Dwa pytania techniczne.'}</h2><div class="project-feature-grid"><article><span class="feature-count">01 / SENSING</span><h3>ArtiSense</h3><p>{locale==='en'?'A proposed compact photonic sensing system. The glucose example is research and design work; validated measurement remains to be demonstrated.':'Proponowany kompaktowy system detekcji fotonicznej. Przykład glukozy to badania i projektowanie; pomiar wymaga walidacji.'}</p><a href={routeFor('artisense',locale)}>{locale==='en'?'Explore the sensing research':'Poznaj badania nad detekcją'} <span aria-hidden="true">↗</span></a></article><article><span class="feature-count">02 / DESIGN</span><h3>AIFIELD</h3><p>{locale==='en'?'Photonic design and simulation workflows, with a separate neural-field research direction. Human review remains part of AI-assisted work.':'Procesy projektowania i symulacji fotoniki oraz osobny kierunek badań nad polem neuronowym. Praca z AI nadal wymaga oceny człowieka.'}</p><a href={routeFor('aifield',locale)}>{locale==='en'?'Explore the design workflow':'Poznaj proces projektowania'} <span aria-hidden="true">↗</span></a></article></div></div></section>}
{page.sections.map((section,index)=><section id={section.id} class:list={['section',{mist:index%2===1}]}><div class="container section-grid"><div><p class="section-index">0{index+1} / {page.eyebrow}</p><h2>{section.title}</h2></div><div class="reading">{section.paragraphs.map(p=><p>{p}</p>)}{index===1&&project&&<div class="notice">{locale==='en'?'Evidence level: research, design and simulation. No fabricated-device or clinical result is claimed.':'Poziom dowodów: badania, projekt i symulacja. Nie deklarujemy wyników wykonanego urządzenia ani badań klinicznych.'}</div>}</div></div></section>)}
{id==='contact'&&<section class="section"><div class="container"><h2>{locale==='en'?'Your enquiry':'Twoje zapytanie'}</h2><EnquiryForm {locale}/></div></section>}
{id!=='contact'&&id!=='privacy'&&<section class="related"><div class="container"><p class="eyebrow">{locale==='en'?'Continue exploring':'Czytaj dalej'}</p><h2>{locale==='en'?'Follow the evidence. Start a conversation.':'Sprawdź dowody. Rozpocznij rozmowę.'}</h2><div class="related-grid">{page.related.filter(r=>r!==id).slice(0,5).map(r=>{const target=routes.find(x=>x.id===r)!;return <a href={routeFor(r,locale)}>{target.labels[locale]} <span aria-hidden="true">↗</span></a>})}<a href={contact}>{cta} <span aria-hidden="true">↗</span></a></div></div></section>}
{id==='artisense'&&locale==='pl'&&<script is:inline>const aliases={'o-module':'/pl/projekty/artisense/#focus','fotonika':'/pl/projekty/artisense/technologia/#focus','elektronika':'/pl/projekty/artisense/technologia/#evidence','technologie':'/pl/projekty/artisense/technologia/#next'};const target=aliases[decodeURIComponent(location.hash.slice(1))];if(target)location.replace(target);</script>}
</PageFrame>
