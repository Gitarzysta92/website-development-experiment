---
import Header from '../partials/Header.astro';import Footer from '../partials/Footer.astro';import '../styles/site.css';import { routeFor, type PageId, type Locale } from '../navigation';
const {id,locale,title,description} = Astro.props as {id:PageId;locale:Locale;title:string;description:string};
const origin=process.env.SITE_ORIGIN ?? 'http://127.0.0.1:4321';
const preview=process.env.SITE_PROFILE!=='published';
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · Artifactory</title><meta name="description" content={description}/>{preview&&<meta name="robots" content="noindex,nofollow"/>}<link rel="canonical" href={new URL(routeFor(id,locale),origin).href}/><link rel="alternate" hreflang="en" href={new URL(routeFor(id,'en'),origin).href}/><link rel="alternate" hreflang="pl" href={new URL(routeFor(id,'pl'),origin).href}/><link rel="alternate" hreflang="x-default" href={new URL(routeFor(id,'en'),origin).href}/><meta property="og:title" content={`${title} · Artifactory`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL("/share-v1.svg",origin).href}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><a class="skip" href="#main">{locale==='en'?'Skip to content':'Przejdź do treści'}</a><div class="draft">{locale==='en'?'Local draft preview · not approved for publication':'Lokalny podgląd szkicu · niezatwierdzony do publikacji'}</div><Header {id} {locale}/><main id="main"><slot/></main><Footer {locale}/></body></html>
