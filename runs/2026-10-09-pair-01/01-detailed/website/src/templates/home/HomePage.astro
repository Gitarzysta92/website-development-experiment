---
import type {PageView} from '../../content/index';
import {routeFor,contactHref} from '../../navigation/index';
import Button from '../../components/ui/Button.astro';
import ConceptVisual from '../../components/ui/ConceptVisual.astro';
import Figure from '../../components/ui/Figure.astro';
import EvidenceTable from '../../components/ui/EvidenceTable.astro';
import ProjectCollection from '../projects/ProjectCollection.astro';
interface Props{page:PageView;}const {page}=Astro.props;const pl=page.locale==='pl';const [thesis,evidence,conversation]=['thesis', 'evidence', 'conversation'].map(id=>page.sections.find(s=>s.id===id)!);
---
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lead">{page.lead}</p><div class="actions"><Button href={routeFor('investors',page.locale)}>{pl?'Poznaj potencjał inwestycyjny':'Explore the investment case'}</Button><a class="text-link" href={routeFor('projects',page.locale)}>{pl?'Poznaj projekty':'Discover the projects'} <span aria-hidden="true">↓</span></a></div></div><Figure caption={page.visualCaption!}><ConceptVisual kind="company" label={pl?'Koncepcyjny chip fotoniczny ze ścieżkami światła i punktem analizy sygnału.':'Conceptual photonic chip with light paths and a signal-analysis point.'} labels={[pl?'ARTIFACTORY / FOTONIKA':'ARTIFACTORY / PHOTONICS',pl?'POMIAR. PROJEKTOWANIE. MOŻLIWOŚCI.':'SENSING. DESIGN. POSSIBILITY.']}/></Figure></div></section>
<section class="thesis-band" id={thesis.id}><div class="container split"><h2>{thesis.title}</h2><div>{thesis.paragraphs.map(p=><p>{p}</p>)}</div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">{pl?'DWA KIERUNKI. WSPÓLNY KONTEKST.':'TWO DIRECTIONS. CONNECTED THINKING.'}</p><h2>{pl?'Od pomiaru do projektu.':'From sensing to design.'}</h2></div><p>{pl?'Poznaj cel, obecny zakres prac i pytania, które wyznaczają kolejny krok każdego projektu.':'Explore the purpose, available work and open questions that define the next step for each project.'}</p></div><ProjectCollection sections={page.sections.filter(s=>['artisense','aifield'].includes(s.id))} locale={page.locale}/></section>
<section class="section wash" id={evidence.id}><div class="container"><div class="section-heading"><h2>{evidence.title}</h2><p>{evidence.paragraphs[0]}</p></div><EvidenceTable rows={evidence.rows!} headers={pl?['Projekt i etap','Co wynika z dostępnych prac']:['Project and stage','What the available work supports']} label={evidence.title}/><a class="text-link" href={routeFor('approach',page.locale)}>{pl?'Jak rozumiemy dowody':'How we think about evidence'} <span aria-hidden="true">↗</span></a></div></section>
<section class="section container" id={conversation.id}><div class="split"><div><p class="eyebrow">{pl?'KOLEJNY KROK':'THE NEXT CONVERSATION'}</p><h2>{conversation.title}</h2></div><div>{conversation.paragraphs.map(p=><p>{p}</p>)}<div class="actions"><Button href={contactHref(page.locale,'investment')}>{pl?'Porozmawiajmy o inwestycji':'Discuss an investment'}</Button><a class="text-link" href={routeFor('partnerships',page.locale)}>{pl?'Możliwości współpracy':'Explore partnerships'} ↗</a><a class="text-link" href={routeFor('about',page.locale)}>{pl?'O Artifactory':'About Artifactory'} ↗</a></div></div></div></section>
<style>.thesis-band{padding-block:56px;border-block:1px solid var(--af-line);background:var(--af-mist)}.thesis-band h2{font-size:clamp(30px,2.8vw,40px)}.thesis-band p{font-size:18px;color:var(--af-muted)}.hero{background:radial-gradient(ellipse at 85% 60%,#087f8c06,transparent 50%)}@media(max-width:48rem){.thesis-band{padding-block:48px}}</style>
