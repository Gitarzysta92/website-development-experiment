---
import {route,routes,ancestors,enquiryHref,type Locale} from '../navigation';
import ProjectNav from '../partials/ProjectNav.astro';
import Concept from '../components/ui/Concept.astro';
import ContactForm from '../features/enquiry/presentation/ContactForm.astro';
const {id,locale,page}=Astro.props as {id:string;locale:Locale;page:any};
const r=routes.find(x=>x.id===id)!;
const L=(en:string,pl:string)=>locale==='pl'?pl:en;
const project=r.project as 'artisense'|'aifield'|null;
const isHome=id==='home';
const isTechnical=!!project&&id!==project;
const isContact=id==='contact';
const isPrivacy=id==='privacy';
const related=page.related.map((x:string)=>routes.find(r=>r.id===x)).filter(Boolean);
const action=id==='partnerships'?enquiryHref(locale,'partnership'):project==='aifield'?enquiryHref(locale,'demo','aifield'):enquiryHref(locale,'investment');
---
<main id="main">
{!isHome&&<nav class="breadcrumbs container" aria-label={L('Breadcrumb','Ścieżka')}><a href={route('home',locale)}>{L('Home','Strona główna')}</a>{ancestors(id).filter(x=>x.id!=='home').map(x=><><span aria-hidden="true">/</span><a href={route(x.id,locale)}>{x.labels[locale]}</a></>)}<span aria-hidden="true">/</span><span aria-current="page">{r.labels[locale]}</span></nav>}
<section class:list={['hero',isHome?'hero-home':'hero-inner',project?'hero-project':'']}><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span>{page.eyebrow} / {isHome?'01':project?L('Project dossier','Opis projektu'):L('Company','Firma')}</p><h1>{page.title}</h1><p class="hero-lead">{page.lead}</p><div class="hero-actions"><a class="button" href={isHome?route('investors',locale):action}>{isHome?L('Explore the investment case','Poznaj potencjał inwestycyjny'):id==='partnerships'?L('Discuss a partnership','Porozmawiajmy o współpracy'):project==='aifield'?L('Request a conversation','Poproś o rozmowę'):L('Discuss an investment','Porozmawiajmy o inwestycji')}<span aria-hidden="true">↗</span></a><a class="text-action" href={isHome?route('projects',locale):route(id==='privacy'?'contact':'projects',locale)}>{isHome?L('Explore the projects','Poznaj projekty'):id==='privacy'?L('Go to contact','Przejdź do kontaktu'):L('All projects','Wszystkie projekty')} <span aria-hidden="true">→</span></a></div></div>
<div class="hero-visual">{isHome?<div class="home-art" aria-hidden="true"><div class="art-ring ring-a"></div><div class="art-ring ring-b"></div><div class="art-core"></div><span class="art-label label-a">ArtiSense<br/>SENSING SYSTEM</span><span class="art-label label-b">AIFIELD<br/>DESIGN SYSTEM</span><span class="art-cross">＋</span></div>:project?<Concept project={project} locale={locale} id={id}/>:<div class="statement-panel"><span class="panel-index">AF / {id.toUpperCase()}</span><strong>{id==='investors'?L('Investigate before investing.','Oceń przed inwestycją.'):id==='contact'?L('A good conversation starts with a precise question.','Dobra rozmowa zaczyna się od konkretnego pytania.'):L('From question to evidence.','Od pytania do dowodu.')}</strong><div class="panel-lines" aria-hidden="true"><i></i><i></i><i></i></div></div>}</div></div><div class="hero-foot container"><span>ARTIFACTORY / {id.toUpperCase()}</span><span>{L('Scroll to examine','Przewiń, aby poznać')} ↓</span></div></section>
{id==='artisense'&&locale==='pl'&&<div class="container legacy-anchors" aria-label="Dawne odnośniki do modułu"><div id="o-module"><strong>O module</strong><p>ArtiSense opisuje proponowany system pomiaru optycznego. Szczegóły architektury przedstawia strona technologii.</p><a href={route('artisense-technology',locale)}>Zobacz technologię ↗</a></div><div id="fotonika"><strong>Fotonika</strong><p>Światło oddziałuje z próbką, a układ optyczny kieruje odpowiedź do detekcji.</p><a href={route('artisense-technology',locale)}>Tor optyczny ↗</a></div><div id="elektronika"><strong>Elektronika</strong><p>Detekcja i interpretacja sygnału są odrębnymi etapami proponowanego systemu.</p><a href={route('artisense-technology',locale)}>Detekcja i interpretacja ↗</a></div><div id="technologie"><strong>Technologie</strong><p>Opis elementów nie potwierdza jeszcze zintegrowanego, zwalidowanego urządzenia.</p><a href={route('artisense-validation',locale)}>Stan badań ↗</a></div></div>}
{project&&<div class="container"><ProjectNav id={id} locale={locale} project={project}/></div>}
{isTechnical&&<div class="container intro-note"><span class="note-number">01 / {project==='artisense'?'ArtiSense':'AIFIELD'}</span><p>{project==='artisense'?L('ArtiSense is a proposed sensing system. This page addresses one part of its development; the overview sets the wider context.','ArtiSense to proponowany system pomiarowy. Ta strona opisuje jeden obszar jego rozwoju; szerszy kontekst znajduje się w przeglądzie.'):L('AIFIELD explores tools for photonic design. This page examines one part of that work; the overview introduces the wider workflow.','AIFIELD bada narzędzia projektowania fotoniki. Ta strona omawia jeden obszar prac; przegląd przedstawia cały proces.')}</p><a href={route(project,locale)}>{L('Project overview','Przegląd projektu')} ↗</a></div>}
<div class="container body-layout"><aside class="section-index"><span class="eyebrow">{L('On this page','Na tej stronie')}</span><nav aria-label={L('Page sections','Sekcje strony')}>{page.sections.map((s:any,i:number)=><a href={`#${s.id}`}><span>0{i+1}</span>{s.heading}</a>)}</nav></aside><div class="article-flow">{page.sections.map((section:any,i:number)=><section id={section.id} class="article-section"><div class="section-counter">0{i+1} <span></span> {L('IN FOCUS','W CENTRUM')}</div><h2>{section.heading}</h2>{section.body.map((p:string)=><p>{p}</p>)}{i===0&&project&&<div class="inline-graphic"><div class="graphic-line"><span>{project==='artisense'?L('Signal','Sygnał'):L('Input','Dane')}</span><b>→</b><span>{project==='artisense'?L('Interpretation','Interpretacja'):L('Model','Model')}</span><b>→</b><span>{project==='artisense'?L('Validation','Walidacja'):L('Review','Ocena')}</span></div><small>{L('Explanatory sequence; conceptual, not measured output.','Schemat poglądowy; koncepcja, nie wynik pomiaru.')}</small></div>}</section>)}</div></div>
{(project||id==='projects'||id==='approach'||id==='investors')&&<section class="evidence-band"><div class="container evidence-grid"><div><p class="eyebrow">{L('Reading the evidence','Jak czytać dowody')}</p><h2>{L('What the work supports. What still needs testing.','Co wynika z prac. Co trzeba jeszcze sprawdzić.')}</h2></div><div class="evidence-columns"><div><span class="evidence-icon">✓</span><h3>{L('Available context','Dostępny kontekst')}</h3><p>{project==='artisense'?L('Optical feasibility and design work support a sensing hypothesis and architecture discussion.','Prace nad wykonalnością optyczną i projektem wspierają omówienie hipotezy oraz architektury czujnika.'):L('The September 2026 materials describe design, simulation and research methods under stated assumptions.','Materiały z września 2026 roku opisują projektowanie, symulacje i metody badawcze z określonymi założeniami.')}</p></div><div><span class="evidence-icon outline">?</span><h3>{L('Next proof point','Następny dowód')}</h3><p>{project==='artisense'?L('Integrated measurements, calibration and repeatability under defined conditions remain to be shown.','Trzeba wykazać pomiary zintegrowanego układu, kalibrację i powtarzalność w określonych warunkach.'):L('Reproducible comparisons, real use conditions and independent results remain to be documented.','Należy udokumentować odtwarzalne porównania, rzeczywiste warunki użycia i niezależne wyniki.')}</p></div></div></div></section>}
{isContact&&<ContactForm locale={locale}/>}
{!isPrivacy&&<section class="related-section container"><div class="related-head"><p class="eyebrow">{L('Continue exploring','Poznaj więcej')}</p><h2>{L('Follow the question further.','Pójdź za pytaniem dalej.')}</h2></div><div class="related-list">{related.map((x:any,i:number)=><a href={route(x.id,locale)} class="related-item"><span>0{i+1}</span><strong>{x.labels[locale]}</strong><span class="related-arrow" aria-hidden="true">↗</span></a>)}</div></section>}
{!isContact&&!isPrivacy&&<section class="closing-cta"><div class="container closing-grid"><div><p class="eyebrow">ARTIFACTORY / {L('Next step','Następny krok')}</p><h2>{L('Have a precise question? Let’s start there.','Masz konkretne pytanie? Zacznijmy od niego.')}</h2></div><a class="button button-light" href={action}>{id==='partnerships'?L('Discuss a partnership','Porozmawiajmy o współpracy'):L('Start a conversation','Rozpocznij rozmowę')} ↗</a></div></section>}
</main>
