---
import Shell from '../layouts/Shell.astro';
export const prerender=false;
const locale=Astro.url.pathname.startsWith('/pl/')?'pl':'en';
Astro.response.status=404;
const page={title:locale==='pl'?'Nie znaleziono strony':'Page not found',description:locale==='pl'?'Nie można znaleźć tej strony.':'This page could not be found.',eyebrow:'404',lead:locale==='pl'?'Sprawdź adres lub wróć do projektów.':'Check the address or return to the projects.',sections:[],related:['projects']};
---
<Shell id="404" locale={locale} page={page}><main id="main" class="container error-page"><p class="eyebrow">404</p><h1>{page.title}</h1><p>{page.lead}</p><a class="button" href={locale==='pl'?'/pl/projekty/':'/en/projects/'}>{locale==='pl'?'Zobacz projekty':'Explore projects'}</a></main></Shell>
