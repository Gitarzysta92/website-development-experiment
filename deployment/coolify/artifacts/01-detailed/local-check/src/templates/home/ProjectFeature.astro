---
import type {PageView} from '../../content/index';
import {routeFor,labelFor,type PageId} from '../../navigation/index';
import ConceptVisual from '../../components/ui/ConceptVisual.astro';
import Figure from '../../components/ui/Figure.astro';
interface Props{section:PageView['sections'][number];locale:PageView['locale'];index:number;prefix?:string;showVisual?:boolean;}
const {section,locale,index,prefix='',showVisual=true}=Astro.props;const pl=locale==='pl';const project=section.id==='artisense'?'artisense':'aifield';
---
<article class:list={['project-feature',{reverse:index%2===0}]} id={prefix+section.id}>{showVisual&&<div class="feature-visual"><Figure caption={pl?'Ilustracja koncepcyjna. Nie przedstawia gotowego produktu ani wyników pomiarów.':'Concept illustration. Not a finished product or measured output.'}><ConceptVisual idPrefix={prefix+section.id} kind={project==='artisense'?'sensing':'design'} label={pl?(project==='artisense'?'Koncepcja układu optycznego przekształcającego oddziaływanie ze światłem w sygnał.':'Koncepcja projektowania geometrii fotonicznej i analizy jej odpowiedzi.'):project==='artisense'?'Concept of an optical system turning interaction with light into a signal.':'Concept of photonic geometry design and response analysis.'} labels={[`${String(index).padStart(2,'0')} / ${project==='artisense'?'ARTISENSE':'AIFIELD'}`,pl?(project==='artisense'?'ŚWIATŁO → SYGNAŁ → INTERPRETACJA':'GEOMETRIA → SYMULACJA → ANALIZA'):(project==='artisense'?'LIGHT → SIGNAL → INTERPRETATION':'GEOMETRY → SIMULATION → INSIGHT')]}/></Figure></div>}<div class="feature-copy"><p class="eyebrow">{pl?(project==='artisense'?'POMIAR PRZEZ ŚWIATŁO':'PROJEKTOWANIE ZE ŚWIATŁEM'):(project==='artisense'?'SENSING THROUGH LIGHT':'DESIGNING WITH LIGHT')}</p><h2>{section.title}</h2>{section.paragraphs.map(p=><p>{p}</p>)}<div class="actions">{section.links?.map(link=><a class="text-link" href={routeFor(link.id as PageId,locale)}>{link.id===project?(pl?`Poznaj ${section.title}`:`Explore ${section.title}`):labelFor(link.id as PageId,locale)} <span aria-hidden="true">↗</span></a>)}</div></div></article>
<style>.project-feature{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;padding-block:64px;border-top:1px solid var(--af-line)}.project-feature.reverse .feature-visual{order:2}.feature-copy p:not(.eyebrow){margin-top:24px;color:var(--af-muted)}.feature-copy h2{font-size:48px}.feature-copy .eyebrow{margin-bottom:16px}@media(max-width:48rem){.project-feature{grid-template-columns:1fr;gap:32px;padding-block:48px}.project-feature.reverse .feature-visual{order:0}.feature-copy h2{font-size:40px}}</style>
