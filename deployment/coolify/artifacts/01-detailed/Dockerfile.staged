# syntax=docker/dockerfile:1
FROM node:24.21.0-bookworm-slim AS build
WORKDIR /app
RUN node --input-type=module -e "import {writeFileSync} from 'node:fs'; import {createHash} from 'node:crypto'; const r=await fetch('http://127.0.0.1:18765/30b3652a0e3d2f01a5c23a95b7c61baeb430b15b4c392f4e7e6fc5071d5b4463.tar.gz'); if(!r.ok) throw Error('Missing build source'); const b=Buffer.from(await r.arrayBuffer()); if(createHash('sha256').update(b).digest('hex')!=='30b3652a0e3d2f01a5c23a95b7c61baeb430b15b4c392f4e7e6fc5071d5b4463') throw Error('Source checksum mismatch'); writeFileSync('/tmp/source.tar.gz',b);" && tar -xzf /tmp/source.tar.gz -C /app && rm /tmp/source.tar.gz
ENV ASTRO_TELEMETRY_DISABLED=1 SITE_PROFILE=preview
RUN npm install -g npm@11.19.0 && npm ci --no-audit --no-fund
RUN npm run build && npm test
RUN npm prune --omit=dev --no-audit --no-fund

FROM node:24.21.0-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production RUN_VARIANT=01-detailed PREVIEW_ORIGIN=https://artifactory-detailed-astra-xhigh.coolify.threesixty.dev GATEWAY_PORT=8080
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "preview-gateway.mjs"]
