SOURCE_ARCHIVE
RUN base64 -d /tmp/source.b64 | tar -xz -C /app && rm /tmp/source.b64
WORKDIR /app/website
ENV ASTRO_TELEMETRY_DISABLED=1 SITE_PROFILE=preview ENQUIRY_MODE=fixture
RUN npm run check && node --check server.js && node --check app.js

FROM node:24.21.0-bookworm-slim
WORKDIR /app/website
ENV NODE_ENV=production RUN_VARIANT=02-inputs-only PREVIEW_ORIGIN=https://artifactory-inputs-only-sol-light.coolify.threesixty.dev GATEWAY_PORT=8080
COPY --from=build --chown=node:node /app/website/package.json /app/website/package.json
COPY --from=build --chown=node:node /app/website/preview-gateway.mjs /app/website/preview-gateway.mjs
COPY --from=build --chown=node:node /app/website/server.js /app/website/content.js /app/website/app.js /app/website/styles.css /app/website/favicon.svg /app/website/
USER node
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "preview-gateway.mjs"]
